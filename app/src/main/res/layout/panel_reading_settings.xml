<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/readingSettingsPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#212121"
    android:padding="16dp"
    android:visibility="gone"
    android:elevation="8dp"
    android:clickable="true"
    android:focusable="true">

    <!-- ========================================== -->
    <!-- MODO DE VISUALIZAÇÃO (PDF Original x Texto)-->
    <!-- ========================================== -->
    <LinearLayout
        android:id="@+id/viewModeToggleRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/labelOriginalPdf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Visualizar PDF Original"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchOriginalPdf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Linha divisória para separar os escopos -->
    <View
        android:id="@+id/viewModeToggleDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#424242"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp" />

    <!-- ========================================== -->
    <!-- CONFIGURAÇÕES DE TEXTO (Desativadas no PDF)-->
    <!-- ========================================== -->
    <LinearLayout
        android:id="@+id/textSettingsGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/labelFollowSystemTheme"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/follow_system_theme"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchFollowSystemTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/labelPageColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/page_color"
            android:textColor="@android:color/white" />

        <LinearLayout
            android:id="@+id/colorOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/colorWhite"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/color_selector_white" />

            <View
                android:id="@+id/colorBlack"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/color_selector_black" />

            <View
                android:id="@+id/colorSepia"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/color_selector_sepia" />
        </LinearLayout>

        <TextView
            android:id="@+id/labelFont"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/font"
            android:textColor="@android:color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDecreaseFont"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/decrease_font" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonIncreaseFont"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/increase_font" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonToggleFontFamily"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/serif_font" />

    </LinearLayout>
</LinearLayout>